# ═══════════════════════════════════════════════════════
# Weather AI Agent — 环境变量配置
# ═══════════════════════════════════════════════════════
#
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env，只配置一个服务商
#
# 不要同时填写两个 API Key；
# 如果两者都存在，程序优先使用 Anthropic。

# ── Anthropic（推荐） ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 模型 ──
LLM_MODEL=claude-haiku-4-5-20251001

# ── 服务端口 ──
PORT=8000
